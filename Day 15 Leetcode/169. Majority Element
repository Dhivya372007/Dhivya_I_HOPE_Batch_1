class Solution {
    public int majorityElement(int[] nums) {
        int maj_ele = nums[0];
        int maj_ele_count = 1;

        for (int i = 1; i < nums.length; i++) {
            if (maj_ele_count == 0) {
                maj_ele = nums[i];
                maj_ele_count = 1;
            } else if (nums[i] == maj_ele) {
                maj_ele_count++;
            } else {
                maj_ele_count--;
            }
        }

        return maj_ele;
    }
}
